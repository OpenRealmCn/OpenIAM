OPENIAM_ENV=development
OPENIAM_HTTP_ADDRESS=:8080
OPENIAM_FRONTEND_ORIGIN=http://localhost:3000
OPENIAM_DATABASE_DSN=openiam:openiam@tcp(localhost:3306)/openiam?charset=utf8mb4&parseTime=True&loc=UTC
OPENIAM_REDIS_ADDRESS=localhost:6379
OPENIAM_REDIS_PASSWORD=
OPENIAM_REDIS_DATABASE=0
OPENIAM_REDIS_KEY_PREFIX=openiam:dev:v1
OPENIAM_SESSION_COOKIE_NAME=openiam_session
OPENIAM_SESSION_COOKIE_SECURE=false

# SMTP (leave OPENIAM_SMTP_HOST empty to log emails instead of sending)
OPENIAM_SMTP_HOST=
OPENIAM_SMTP_PORT=587
OPENIAM_SMTP_USERNAME=
OPENIAM_SMTP_PASSWORD=
OPENIAM_SMTP_FROM_ADDRESS=no-reply@openrealm.io
OPENIAM_SMTP_FROM_NAME=OpenIAM
OPENIAM_SMTP_TLS=starttls

# Feishu OAuth login (leave APP_ID/APP_SECRET empty to disable)
OPENIAM_FEISHU_APP_ID=
OPENIAM_FEISHU_APP_SECRET=
OPENIAM_FEISHU_REDIRECT_URI=http://localhost:8080/api/v1/auth/feishu/callback
OPENIAM_FEISHU_BASE_URL=https://open.feishu.cn/open-apis
OPENIAM_FRONTEND_URL=http://localhost:3000

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=openiam
MYSQL_USER=openiam
MYSQL_PASSWORD=openiam

# OpenIAM 本地启动配置（仅需配置数据库连接、Redis 与服务基础监听参数）
# 其他所有业务、安全、JWT、限流、CORS、OAuth 参数均存储在 MySQL system_settings 表中，可在管理员面板在线修改。

# Docker Compose 对外统一主入口端口（由前端 Nginx 暴露，后端不对外开放端口）
OPENIAM_PORT=5173
# 前端 Nginx 反向代理到后端的内部上游地址（可通过环境变量覆盖，非硬编码）
OPENIAM_BACKEND_UPSTREAM=http://backend:8080
# 后端容器内部监听端口
OPENIAM_BACKEND_PORT=8080

# 本地直接运行 Go 后端时的监听配置
OPENIAM_HOST=127.0.0.1
# debug 模式会输出更详细的日志，仅用于本地开发；生产请使用 release
OPENIAM_MODE=release

# MySQL 持久化连接（必填）
OPENIAM_MYSQL_DSN=openiam:openiam_password@tcp(127.0.0.1:3306)/openiam?charset=utf8mb4&parseTime=True&loc=Local&multiStatements=true

# Redis 临时安全状态存储（必填）
OPENIAM_REDIS_ADDR=127.0.0.1:6379
# 使用 compose 内置 Redis（profile redis/full）时它会以此口令启用认证，请改成随机强口令；
# 外部 Redis 未设口令时可留空（不推荐）。
OPENIAM_REDIS_PASSWORD=change_me_redis_password
OPENIAM_REDIS_DB=0
OPENIAM_REDIS_KEY_PREFIX=openiam:

# 数据库版本检查与自动升级
OPENIAM_AUTO_MIGRATE=true
OPENIAM_STRICT_VERSION_CHECK=true

# 可选：自定义 RS256 私钥文件路径。留空时自动生成并持久化到 OPENIAM_JWT_AUTO_KEY_PATH
# （默认 data/jwt_private.pem，权限 0600），重启后已签发令牌仍然有效。
OPENIAM_JWT_PRIVATE_KEY_PATH=
OPENIAM_JWT_AUTO_KEY_PATH=data/jwt_private.pem

# 敏感字段落库加密密钥（TOTP 种子、联合登录 Client Secret、插件密钥、密钥类系统设置）。
# 32 字节随机值，base64 或 hex 编码，例如：openssl rand -base64 32
# 留空则以明文存储并在启动时告警；一旦启用请妥善备份，丢失后已加密的字段将无法解密。
OPENIAM_DATA_ENCRYPTION_KEY=

# 可信反向代理（仅采信这些来源的 X-Forwarded-For / X-Forwarded-Proto）。
# 本地直接运行默认只信任回环地址；compose 部署会自动加入内部网段 OPENIAM_DOCKER_SUBNET。
OPENIAM_TRUSTED_PROXIES=127.0.0.1,::1
OPENIAM_DOCKER_SUBNET=172.28.0.0/24

# 首次初始化超级管理员账号（幂等；账号已存在时不会重建，也不会覆盖已有口令）
OPENIAM_SEED_ENABLED=true
OPENIAM_SEED_ADMIN_USERNAME=admin
OPENIAM_SEED_ADMIN_EMAIL=admin@openrealm.local
# 空库首次初始化必填：至少 12 位，需同时包含大写字母、小写字母与数字，且不得使用历史默认口令。
# 未设置或不满足策略时启动会直接失败；初始管理员首次登录后会被强制改密。
OPENIAM_SEED_ADMIN_PASSWORD=
